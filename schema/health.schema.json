{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://0x8e8fb-p.github.io/d365-pqu-data/schemas/health.schema.json",
  "title": "D365 PQU dataset health",
  "type": "object",
  "required": [
    "dataset",
    "schema_version",
    "status",
    "checked_at",
    "last_successful_check_at",
    "last_successful_publish_at",
    "last_source_change_at",
    "source_reachable",
    "parser_success",
    "validation_passed",
    "records",
    "current_records",
    "upcoming_records",
    "warning_count",
    "error_count",
    "source_commit",
    "source_sha256"
  ],
  "properties": {
    "dataset": { "const": "d365-finops-pqu" },
    "schema_version": { "type": "string" },
    "status": { "enum": ["healthy", "degraded", "failed"] },
    "checked_at": { "type": "string", "format": "date-time" },
    "last_successful_check_at": { "type": "string", "format": "date-time" },
    "last_successful_publish_at": { "type": "string", "format": "date-time" },
    "last_source_change_at": { "type": "string", "format": "date-time" },
    "source_reachable": { "type": "boolean" },
    "parser_success": { "type": "boolean" },
    "validation_passed": { "type": "boolean" },
    "records": { "type": "integer", "minimum": 0 },
    "current_records": { "type": "integer", "minimum": 0 },
    "upcoming_records": { "type": "integer", "minimum": 0 },
    "warning_count": { "type": "integer", "minimum": 0 },
    "error_count": { "type": "integer", "minimum": 0 },
    "check_interval_minutes": { "type": "integer", "minimum": 1 },
    "source_commit": { "type": "string" },
    "source_sha256": { "type": "string" },
    "checked_commit": {
      "description": "Upstream MicrosoftDocs commit examined by this check (run health only).",
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{40}$"
    },
    "content_commit": {
      "description": "Commit of the published content; unchanged when a newer commit left the articles unchanged.",
      "type": ["string", "null"]
    },
    "run_status": { "enum": ["updated", "unchanged", "heartbeat", "failed"] },
    "error": { "type": ["string", "null"], "maxLength": 500 },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["state"],
        "properties": {
          "state": { "enum": ["updated", "unchanged", "stale", "unavailable", "not_configured", "failed"] },
          "commit": { "type": ["string", "null"] },
          "sha256": { "type": ["string", "null"] },
          "markdown_date": { "type": ["string", "null"], "format": "date" },
          "message": { "type": ["string", "null"], "maxLength": 500 }
        },
        "additionalProperties": false
      }
    }
  }
}
