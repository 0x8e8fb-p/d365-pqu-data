{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://0x8e8fb-p.github.io/d365-pqu-data/schemas/quality-report.schema.json",
  "title": "D365 PQU data quality report",
  "type": "object",
  "required": ["dataset", "schema_version", "generated_at", "source", "count", "status", "error_count", "warning_count", "records"],
  "properties": {
    "dataset": { "const": "d365-finops-pqu" },
    "schema_version": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "source": { "type": "object" },
    "count": { "type": "integer", "minimum": 0 },
    "status": { "enum": ["clean", "warnings", "error"] },
    "error_count": { "type": "integer", "minimum": 0 },
    "warning_count": { "type": "integer", "minimum": 0 },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "message"],
        "properties": {
          "code": { "type": "string" },
          "severity": { "enum": ["error", "warning", "info"] },
          "message": { "type": "string" },
          "pqu_id": { "type": ["string", "null"] },
          "field": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    }
  }
}
