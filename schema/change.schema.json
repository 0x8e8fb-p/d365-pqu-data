{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://0x8e8fb-p.github.io/d365-pqu-data/schemas/change.schema.json",
  "title": "D365 PQU change history",
  "type": "object",
  "required": ["dataset", "schema_version", "generated_at", "source", "count", "records"],
  "properties": {
    "dataset": { "const": "d365-finops-pqu" },
    "schema_version": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "source": { "type": "object" },
    "count": { "type": "integer", "minimum": 0 },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["change_id", "changed_at", "pqu_id", "entity", "change_type", "source_commit"],
        "properties": {
          "change_id": { "type": "string" },
          "changed_at": { "type": "string", "format": "date-time" },
          "pqu_id": { "type": "string" },
          "entity": { "enum": ["pqu", "station", "region"] },
          "change_type": { "enum": ["added", "removed", "modified"] },
          "field": { "type": ["string", "null"] },
          "old_value": {},
          "new_value": {},
          "source_commit": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  }
}
