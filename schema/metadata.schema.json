{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://0x8e8fb-p.github.io/d365-pqu-data/schemas/metadata.schema.json",
  "title": "D365 PQU dataset metadata",
  "type": "object",
  "required": [
    "dataset",
    "schema_version",
    "pipeline_revision",
    "generated_at",
    "first_published_at",
    "last_published_at",
    "record_count",
    "station_schedule_count",
    "region_count",
    "status_counts",
    "current_count",
    "upcoming_count",
    "source",
    "links"
  ],
  "properties": {
    "dataset": { "const": "d365-finops-pqu" },
    "schema_version": { "type": "string" },
    "pipeline_revision": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "first_published_at": { "type": "string", "format": "date-time" },
    "last_published_at": { "type": "string", "format": "date-time" },
    "record_count": { "type": "integer", "minimum": 0 },
    "station_schedule_count": { "type": "integer", "minimum": 0 },
    "region_count": { "type": "integer", "minimum": 0 },
    "status_counts": { "type": "object", "additionalProperties": { "type": "integer" } },
    "current_count": { "type": "integer", "minimum": 0 },
    "upcoming_count": { "type": "integer", "minimum": 0 },
    "latest_pqu_id": { "type": ["string", "null"] },
    "check_interval_minutes": { "type": "integer", "minimum": 1 },
    "service_update_count": { "type": "integer", "minimum": 0 },
    "maintenance_window_count": { "type": "integer", "minimum": 0 },
    "source": { "type": "object" },
    "sources": {
      "description": "Every Microsoft article the dataset is built from, with its publication state and provenance.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["label", "required", "article_url", "file_path", "state", "source"],
        "properties": {
          "label": { "type": "string" },
          "required": { "type": "boolean" },
          "article_url": { "type": "string", "format": "uri" },
          "file_path": { "type": "string" },
          "state": { "enum": ["current", "stale", "unavailable", "not_configured"] },
          "source": { "type": ["object", "null"] }
        },
        "additionalProperties": false
      }
    },
    "links": { "type": "object", "additionalProperties": { "type": "string" } }
  }
}
