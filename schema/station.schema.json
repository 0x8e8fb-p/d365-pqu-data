{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://0x8e8fb-p.github.io/d365-pqu-data/schemas/station.schema.json",
  "title": "D365 PQU station schedule",
  "type": "object",
  "required": ["dataset", "schema_version", "generated_at", "source", "count", "records"],
  "properties": {
    "dataset": { "const": "d365-finops-pqu" },
    "schema_version": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "source": { "type": "object" },
    "count": { "type": "integer", "minimum": 0 },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "pqu_id",
          "application_version",
          "pqu_train",
          "release_number",
          "station",
          "station_label",
          "source"
        ],
        "properties": {
          "pqu_id": { "type": "string" },
          "application_version": { "type": "string" },
          "pqu_train": { "type": "string" },
          "release_number": { "type": "integer" },
          "station": { "type": "integer", "minimum": 1, "maximum": 6 },
          "station_label": { "type": "string" },
          "sandbox_start_date": { "type": ["string", "null"], "format": "date" },
          "sandbox_end_date": { "type": ["string", "null"], "format": "date" },
          "production_start_date": { "type": ["string", "null"], "format": "date" },
          "production_end_date": { "type": ["string", "null"], "format": "date" },
          "source": { "type": "object" }
        },
        "additionalProperties": false
      }
    }
  }
}
