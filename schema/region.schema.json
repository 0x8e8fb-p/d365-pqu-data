{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://0x8e8fb-p.github.io/d365-pqu-data/schemas/region.schema.json",
  "title": "D365 PQU station-to-region mapping",
  "type": "object",
  "required": ["dataset", "schema_version", "generated_at", "source", "count", "records"],
  "properties": {
    "dataset": { "const": "d365-finops-pqu" },
    "schema_version": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "source": { "type": "object" },
    "count": { "type": "integer", "minimum": 0 },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["station", "station_label", "region", "is_region"],
        "properties": {
          "station": { "type": "integer", "minimum": 1, "maximum": 6 },
          "station_label": { "type": "string" },
          "region": { "type": "string", "minLength": 1 },
          "is_region": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  }
}
