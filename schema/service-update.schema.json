{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://0x8e8fb-p.github.io/d365-pqu-data/schemas/service-update.schema.json",
  "title": "D365 Finance and Operations service update schedule",
  "description": "Targeted release schedule from Microsoft's Service update availability article, with that article's provenance.",
  "type": "object",
  "required": ["dataset", "schema_version", "generated_at", "source_key", "state", "source", "count", "records"],
  "properties": {
    "dataset": { "const": "d365-finops-pqu" },
    "schema_version": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "source_key": { "const": "service_updates" },
    "state": {
      "description": "current: from the latest article; stale: the latest article could not be read, so the last published copy is kept; unavailable: never published; not_configured: not requested by this run.",
      "enum": ["current", "stale", "unavailable", "not_configured"]
    },
    "source": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/source" }] },
    "count": { "type": "integer", "minimum": 0 },
    "records": { "type": "array", "items": { "$ref": "#/$defs/record" } }
  },
  "$defs": {
    "date": { "type": ["string", "null"], "format": "date" },
    "source": {
      "type": "object",
      "required": ["publisher", "repository", "branch", "file_path", "commit", "article_url", "raw_url", "sha256", "retrieved_at"],
      "properties": {
        "publisher": { "type": "string" },
        "repository": { "type": "string" },
        "branch": { "type": "string" },
        "file_path": { "type": "string" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "article_url": { "type": "string", "format": "uri" },
        "raw_url": { "type": "string", "format": "uri" },
        "markdown_date": { "type": ["string", "null"], "format": "date" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "retrieved_at": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "record": {
      "type": "object",
      "required": [
        "version",
        "release_label",
        "is_major",
        "preview_date",
        "preview_latest_update_date",
        "general_availability_date",
        "first_autoupdate_date",
        "second_autoupdate_date",
        "end_of_service_date"
      ],
      "properties": {
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "release_label": { "type": ["string", "null"] },
        "is_major": { "type": "boolean" },
        "preview_date": { "$ref": "#/$defs/date" },
        "preview_latest_update_date": { "$ref": "#/$defs/date" },
        "general_availability_date": { "$ref": "#/$defs/date" },
        "first_autoupdate_date": { "$ref": "#/$defs/date" },
        "second_autoupdate_date": { "$ref": "#/$defs/date" },
        "end_of_service_date": { "$ref": "#/$defs/date" }
      },
      "additionalProperties": false
    }
  }
}
